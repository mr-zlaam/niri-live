include "./cfg/animation.kdl"
workspace "work 5"
workspace "work 6"
workspace "work 7"
workspace "work 4"
workspace "work 3"
workspace "work2"
workspace "work1"
output "eDP-1" {
    mode "1920x1080@60.020"

    scale 1.0

    transform "normal"
    position x=0 y=0
}
include "./cfg/autostart.kdl"
include "./cfg/keybinds.kdl"
include "./cfg/input.kdl"
include "./cfg/display.kdl"
include "./cfg/layout.kdl"
include "./cfg/rules.kdl"
include "./cfg/misc.kdl"

environment {
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
}
blur {
    // 1. BLUR STRENGTH (More passes = heavier, smoother frosted glass)
    // Default is 3. Bump it up to 4 or 5 for an incredibly strong, thick blur.
    passes 4

    // 2. SAMPLE RADIUS (Spread distance per rendering pass)
    // Default is 3.0. Higher values (like 4.0 or 5.0) spread the blur wider,
    // making background shapes softer but potentially causing blocky edges if set too high.
    offset 3.0
}
// Set rounded corners for all windows globally
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
    open-maximized true

}


include "noctalia.kdl"
