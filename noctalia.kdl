layout {

    focus-ring {
        off

        active-color "#adcbdb"
        inactive-color "#121414"
        urgent-color "#ffb4ab"
    }

    border {
        active-color "#adcbdb"
        inactive-color "#121414"
        urgent-color "#ffb4ab"
    }


    tab-indicator {
        active-color "#adcbdb"
        inactive-color "#3a5664"
        urgent-color "#ffb4ab"
    }

    insert-hint {
        color "#adcbdb80"
    }
    gaps 16
}

recent-windows {
    highlight {
        active-color "#adcbdb"
        urgent-color "#ffb4ab"
    }
}
